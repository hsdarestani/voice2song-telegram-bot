# Telegram
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Web admin
APP_NAME=Voice2Song
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
SECRET_KEY=CHANGE_THIS_RANDOM_SECRET
WEB_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_BASE_URL=https://your-domain.com

# Optional: numeric Telegram ID of admin for receiving alerts
ADMIN_TELEGRAM_ID=

# Runtime
APP_TZ=Asia/Tehran
DATA_DIR=data
MAX_WORKERS=1

# Venice AI Music backend
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
MUSIC_BACKEND=venice
VENICE_MUSIC_MODEL=ace-step-15
VENICE_FALLBACK_MODEL=minimax-music-v2
VENICE_DURATION_SECONDS=60
VENICE_MAX_POLL_SECONDS=360
VENICE_POLL_INTERVAL_SECONDS=5
VENICE_USE_QUOTE=true
VENICE_COMPLETE_AFTER_DOWNLOAD=true
MIDI_FALLBACK_ENABLED=false
DEFAULT_STYLE=random
RAW_VOCAL_MIX=false
MAX_AUDIO_SECONDS=30
MIN_MELODY_NOTES=4
SEND_MIDI_ADVANCED=false
